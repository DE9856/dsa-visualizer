# Dependencies — restored by `npm install`
node_modules/

# Build output — regenerated by `npm run build`
dist/
dist-ssr/
*.local

# Design-review screenshots and inspector reports (local working files)
.taste-skill/

# Per-machine Impeccable settings; .impeccable/design.json stays tracked
.impeccable/config.local.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editors and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
